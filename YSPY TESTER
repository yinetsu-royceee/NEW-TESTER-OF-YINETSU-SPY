track(RunService.RenderStepped:Connect(function()
    fpsCounter = fpsCounter + 1
    local now = os.clock()
    if now - lastFPSUpdate >= 1 then
        currentFPS = fpsCounter / (now - lastFPSUpdate)
        fpsCounter = 0
        lastFPSUpdate = now
    end
    for _, item in ipairs(chromaStrokes) do
        if item.Gradient and item.Gradient.Parent then
            item.Gradient.Rotation = (item.Gradient.Rotation + CONFIG.ChromaSpeed) % 360
        end
    end
end))

local function readPing()
    local ok, res = pcall(function()
        local n = Stats:FindFirstChild("Network")
        if not n then return nil end
        local ss = n:FindFirstChild("ServerStatsItem")
        if not ss then return nil end
        local p = ss:FindFirstChild("Data Ping")
        if p then return p:GetValueString() end
    end)
    return (ok and res) and tostring(res) or "N/A"
end

local function fmtClock(s)
    s = math.max(0, math.floor(s))
    return string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)
end

task.spawn(function()
    while not isDestroyed and ScreenGui.Parent do
        local elapsed = os.clock() - appStartedAt
        local mem = "N/A"
        local ok, r = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
        if ok and type(r) == "number" then mem = string.format("%.1f MB", r) end

        if FPSValue then
            FPSValue.Text = string.format("%.0f FPS", currentFPS)
            PingValue.Text = readPing()
            MemoryValue.Text = mem
            ClockValue.Text = fmtClock(elapsed)
            RemotesValue.Text = tostring(#logQueue)
            PlaceValue.Text = tostring(game.PlaceId)
            PlayersValue.Text = tostring(#Players:GetPlayers())
        end
        if HomeFPSValue then HomeFPSValue.Text = string.format("%.0f", currentFPS) end
        if SessionClock then SessionClock.Text = "Session: "..fmtClock(elapsed) end
        task.wait(CONFIG.MonitorInterval)
    end
end)

