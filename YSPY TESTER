local function makeCorner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r or 8)
    return c
end

local function makeStroke(p, col, thick, transp)
    local s = Instance.new("UIStroke", p)
    s.Color = col or CurrentTheme.Border
    s.Thickness = thick or 1
    s.Transparency = transp or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function makeGradientStroke(p, colA, colB, thick, rot)
    local s = Instance.new("UIStroke", p)
    s.Thickness = thick or 1.4
    s.Color = Color3.new(1,1,1)
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    local g = Instance.new("UIGradient", s)
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, colA),
        ColorSequenceKeypoint.new(0.5, colB),
        ColorSequenceKeypoint.new(1, colA),
    })
    g.Rotation = rot or 90
    return s, g
end

local function makePadding(p, px)
    local pad = Instance.new("UIPadding", p)
    pad.PaddingTop = UDim.new(0, px)
    pad.PaddingBottom = UDim.new(0, px)
    pad.PaddingLeft = UDim.new(0, px)
    pad.PaddingRight = UDim.new(0, px)
    return pad
end

local function tw(obj, t, props, style, dir)
    local ti = TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    local a = TweenService:Create(obj, ti, props)
    a:Play()
    return a
end

