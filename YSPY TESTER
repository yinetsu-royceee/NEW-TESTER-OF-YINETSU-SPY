local CurrentTheme = Themes.NeoCyberpunk
local ThemeRegistry = {}

local function registerThemed(instance, propName, themeKey)
    table.insert(ThemeRegistry, {obj = instance, prop = propName, key = themeKey})
    instance[propName] = CurrentTheme[themeKey]
end

local function tweenTheme(obj, prop, col)
    if not obj or not obj.Parent then return end
    TweenService:Create(obj, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {[prop] = col}):Play()
end

local function applyTheme(name)
    CurrentTheme = Themes[name] or Themes.NeoCyberpunk
    for _, e in ipairs(ThemeRegistry) do
        if e.obj and e.obj.Parent then
            local t = CurrentTheme[e.key]
            if t then tweenTheme(e.obj, e.prop, t) end
        end
    end
end

