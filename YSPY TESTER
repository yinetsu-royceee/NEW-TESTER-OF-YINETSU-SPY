local function updateResponsive()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local w = math.clamp(vp.X - 24, CONFIG.MinWidth, CONFIG.MainWidth)
    local h = math.clamp(vp.Y - 48, CONFIG.MinHeight, CONFIG.MainHeight)
    Main.Size = UDim2.new(0, w, 0, h)

    local compact = vp.X < 900
    Navigation.Size = UDim2.new(0, compact and 130 or 175, 1, -102)
    Content.Position = UDim2.new(0, compact and 156 or 201, 0, 88)
    Content.Size = UDim2.new(1, compact and -170 or -215, 1, -102)
    HeaderTitle.TextSize = compact and 14 or 17
end

