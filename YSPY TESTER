        entry.btn:SetAttribute("active", isActive)
        if entry.ind then
            tw(entry.ind, 0.25, {BackgroundTransparency = isActive and 0 or 1})
        end
        tw(entry.btn, 0.25, {
            BackgroundTransparency = isActive and 0.75 or 1,
            TextColor3 = isActive and CurrentTheme.Text or CurrentTheme.TextDim
        })
    end
