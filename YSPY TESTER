local function makeButtonPremium(button, opts)
    opts = opts or {}
    local baseColor = opts.color or button.BackgroundColor3
    local accent = opts.accent or CurrentTheme.Border
    local baseSize = button.Size
    local expand = opts.expand or 2
    local shrink = opts.shrink or 4

