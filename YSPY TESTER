function applyThemeToAll()
    local ti = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, entry in ipairs(themeRegistry) do
        local el = entry.el
        if el and el.Parent then
            local color = currentTheme[entry.role]
            if color then
                if entry.kind == "bg" then
                    TweenService:Create(el, ti, {BackgroundColor3 = color}):Play()
                elseif entry.kind == "text" then
                    TweenService:Create(el, ti, {TextColor3 = color}):Play()
                elseif entry.kind == "stroke" then
                    TweenService:Create(el, ti, {Color = color}):Play()
                elseif entry.kind == "placeholder" then
                    TweenService:Create(el, ti, {PlaceholderColor3 = color}):Play()
                end
            end
        end
    end
    -- Update chroma gradients
    for _, item in ipairs(chromaStrokes) do
        if item.Stroke and item.Stroke.Parent then
            item.Stroke.Color = currentTheme.Accent
            if item.Gradient then
                item.Gradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, currentTheme.Accent),
                    ColorSequenceKeypoint.new(0.5, currentTheme.AccentAlt),
                    ColorSequenceKeypoint.new(1, currentTheme.Accent),
                })
            end
        end
    end
    -- Refresh scrollbar colors
    if RemoteLogScroll then RemoteLogScroll.ScrollBarImageColor3 = currentTheme.Accent end
    for _, pg in pairs(Pages) do pcall(function() pg.ScrollBarImageColor3 = currentTheme.Accent end) end
end

local function applyTheme(themeName)
    local theme = Themes[themeName]
    if not theme then return end
    currentThemeName = themeName
    currentTheme = theme
    applyThemeToAll()
    ThemeStatus.Text = "Current: "..themeName
    addSysLog("Theme changed to "..themeName, "UI")
end

