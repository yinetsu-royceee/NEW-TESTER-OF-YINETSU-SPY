local function runIntro(onComplete)
    tw(introLogo, 0.9, {TextTransparency = 0})
    task.wait(0.25)
    tw(introSub, 0.9, {TextTransparency = 0})
    task.wait(0.3)
    tw(introLog, 0.4, {TextTransparency = 0})
    tw(pctLabel, 0.4, {TextTransparency = 0})

    local pulseConn
    pulseConn = RunService.RenderStepped:Connect(function()
        if not introLogo.Parent then pulseConn:Disconnect() return end
        local p = 0.5 + math.sin(tick() * 2.4) * 0.5
        introLogo.TextColor3 = Color3.fromRGB(0, 240, 255):Lerp(Color3.fromRGB(255, 40, 200), p * 0.5)
    end)

    task.spawn(function()
        for i, line in ipairs(introLines) do
            if not introLog.Parent then break end
            introLog.Text = "[ " .. i .. " / " .. #introLines .. " ]  " .. line
            introLog.TextTransparency = 1
            tw(introLog, 0.25, {TextTransparency = 0})
            task.wait(0.45)
            tw(introLog, 0.2, {TextTransparency = 0.4})
        end
    end)

    local barTween = TweenService:Create(barFill,
        TweenInfo.new(3.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = UDim2.new(1, 0, 1, 0)})
    barTween:Play()

    local pctConn
    pctConn = RunService.RenderStepped:Connect(function()
        if not pctLabel.Parent then pctConn:Disconnect() return end
        local p = math.floor(barFill.AbsoluteSize.X / math.max(barTrack.AbsoluteSize.X, 1) * 100)
        pctLabel.Text = math.clamp(p, 0, 100) .. "%"
    end)

    barTween.Completed:Connect(function()
        if pulseConn then pulseConn:Disconnect() end
        if pctConn then pctConn:Disconnect() end
        task.wait(0.3)
        tw(introLogo, 0.5, {TextTransparency = 1})
        tw(introSub, 0.5, {TextTransparency = 1})
        tw(introLog, 0.5, {TextTransparency = 1})
        tw(pctLabel, 0.5, {TextTransparency = 1})
        tw(introRoot, 0.7, {BackgroundTransparency = 1})
        task.wait(0.75)
        IntroGui:Destroy()
        if onComplete then onComplete() end
    end)
end

