local function premiumBtn(parent, text, size, pos, callback)
    local b = create("TextButton", {
        Size = size, Position = pos,
        BackgroundColor3 = currentTheme.SurfaceAlt,
        BorderSizePixel = 0, AutoButtonColor = false,
        Text = text, TextColor3 = currentTheme.Text,
        Font = Enum.Font.GothamSemibold, TextSize = 12, TextWrapped = true,
    }, parent)
    reg(b, "bg", "SurfaceAlt")
    reg(b, "text", "Text")
    corner(b, 9)
    local s = stroke(b, "Accent", 1, 0.35, true)
    local baseSize = b.Size

    local function tw(props, dur)
        TweenService:Create(b, TweenInfo.new(dur or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
    end

    track(b.MouseEnter:Connect(function()
        if not b.Parent then return end
        tw({BackgroundColor3 = currentTheme.Accent}, 0.14); s.Transparency = 0.05
    end))
    track(b.MouseLeave:Connect(function()
        if not b.Parent then return end
        tw({BackgroundColor3 = currentTheme.SurfaceAlt, Size = baseSize}, 0.14); s.Transparency = 0.35
    end))
    track(b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            tw({Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset-3, baseSize.Y.Scale, baseSize.Y.Offset-2)}, 0.07)
        end
    end))
    track(b.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            tw({Size = baseSize}, 0.1)
        end
    end))
