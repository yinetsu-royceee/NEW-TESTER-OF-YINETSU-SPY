--==============================================================
local themeRegistry = {}  -- {el=Instance, kind="bg"/"text"/"stroke"/"placeholder", role="Accent"}
local chromaStrokes = {}

local function reg(el, kind, role)
    if el then table.insert(themeRegistry, {el=el, kind=kind, role=role}) end
    return el
end

--==============================================================
-- HELPERS
--==============================================================
local connections = {}
local isDestroyed = false
local function track(c) table.insert(connections, c); return c end

local function create(cls, props, parent)
    local i = Instance.new(cls)
    for k,v in pairs(props or {}) do i[k] = v end
    i.Parent = parent
    return i
end

local function corner(p, r)
    return create("UICorner", {CornerRadius=UDim.new(0, r or 10)}, p)
end

local function stroke(p, role, thick, trans, chroma)
    role = role or "Accent"
    local s = create("UIStroke", {
        Color = currentTheme[role] or currentTheme.Accent,
        Thickness = thick or 1,
        Transparency = trans or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
    reg(s, "stroke", role)

    if chroma then
        local g = create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, currentTheme.Accent),
                ColorSequenceKeypoint.new(0.5, currentTheme.AccentAlt),
                ColorSequenceKeypoint.new(1, currentTheme.Accent),
            }),
            Rotation = 0,
        }, s)
        table.insert(chromaStrokes, {Stroke=s, Gradient=g})
    end
    return s
end

local function padding(p, l, r, t, b)
    return create("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
    }, p)
end

local function label(parent, text, size, pos, fs, role)
    role = role or "Text"
    local l = create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text, Size = size, Position = pos,
        Font = Enum.Font.Gotham, TextSize = fs or 14,
        TextColor3 = currentTheme[role] or currentTheme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
    reg(l, "text", role)
    return l
end

local function panel(parent, name, size, pos)
    local p = create("Frame", {
        Name = name, Size = size, Position = pos,
        BackgroundColor3 = currentTheme.Surface, BorderSizePixel = 0,
    }, parent)
    reg(p, "bg", "Surface")
    corner(p, 12)
    stroke(p, "Accent", 1, 0.45, true)
    return p
end

--==============================================================
-- SERIALIZERS
--==============================================================
local function yinetsuBeautify(v, indent, visited)
    indent = indent or 0; visited = visited or {}
    if visited[v] then return "recursive_table" end
    visited[v] = true
    local spacing = string.rep(" ", indent)
    local t = typeof(v)
    if t=="number" or t=="boolean" then return tostring(v)
    elseif t=="string" then return '"'..v:gsub('"','\\"')..'"'
    elseif t=="Vector3" then return "Vector3.new("..tostring(v)..")"
    elseif t=="Vector2" then return "Vector2.new("..tostring(v)..")"
    elseif t=="CFrame" then return "CFrame.new("..tostring(v)..")"
    elseif t=="Color3" then return "Color3.new("..tostring(v)..")"
    elseif t=="EnumItem" then return tostring(v)
    elseif t=="Instance" then return v:GetFullName()
    elseif t=="table" then
        local s="{\n"; local count=0
        for k,val in next,v do
            count=count+1
            s=s..spacing.." ["..yinetsuBeautify(k,indent+1,visited).."] = "..yinetsuBeautify(val,indent+1,visited)..",\n"
        end
        return count==0 and "{}" or s..spacing.."}"
    end
    return "nil"
end

local function v2s(v, visited)
    visited = visited or {}
    if visited[v] then return "recursive_table" end
    visited[v] = true
    local t = typeof(v)
    if t=="number" or t=="boolean" then return tostring(v)
    elseif t=="string" then return '"'..v:gsub('"','\\"')..'"'
    elseif t=="Vector3" then return "Vector3.new("..tostring(v)..")"
    elseif t=="Vector2" then return "Vector2.new("..tostring(v)..")"
    elseif t=="CFrame" then return "CFrame.new("..tostring(v)..")"
    elseif t=="Color3" then return "Color3.new("..tostring(v)..")"
    elseif t=="EnumItem" then return tostring(v)
    elseif t=="Instance" then return v:GetFullName()
    elseif t=="table" then
        local s="{" for k,val in next,v do s=s.."["..v2s(k,visited).."] = "..v2s(val,visited)..", " end
        return s:sub(1,#s-2).."}"
    end
    return "nil"
end

