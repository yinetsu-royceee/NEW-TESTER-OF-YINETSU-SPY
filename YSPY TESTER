-- Helper: fire a remote with args
local function fireRemote(remote, args)
    if not remote or not remote.Parent then return end
    pcall(function()
        if remote.ClassName == "RemoteEvent" then
            remote:FireServer(unpack(args))
        else
            remote:InvokeServer(unpack(args))
        end
    end)
end

-- Helper: parallel spam (all fire ~same time)
local function doSpam(remote, args, count, interval)
    if not remote or not remote.Parent then return end
    count = math.max(1, math.floor(count or 50))
    interval = math.max(0, tonumber(interval) or 0)
    if interval <= 0 then
        -- Fire ALL at the same time using parallel task.spawn
        for i = 1, count do
            task.spawn(function() fireRemote(remote, args) end)
        end
    else
        -- Sequential with wait (converted to ms delay through task.wait)
        task.spawn(function()
            for i = 1, count do
                fireRemote(remote, args)
                if interval > 0 then task.wait(interval) end
            end
        end)
    end
end

