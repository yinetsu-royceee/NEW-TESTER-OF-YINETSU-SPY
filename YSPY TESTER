local function showPage(name)
    for n, f in pairs(Pages) do
        if n == name then
            f.Visible = true
            PageTitle.Text = n
            f.Position = UDim2.new(0, 12, 0, 0)
            tw(f, 0.35, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        else
            f.Visible = false
        end
    end
    ActivePage = name
    setNavActive(name)
end

