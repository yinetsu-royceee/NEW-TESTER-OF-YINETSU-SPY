--==============================================================
-- ADD LOG (core spy function)
--==============================================================
function addLog(remote, args, isLoaded)
    if not getgenv().YinetsuUIActive then return end
    if blacklist[remote] or blacklist[remote.Name] then return end
    if recording then
        table.insert(recordedSeq, {remote = remote, args = args})
        if #recordedSeq > 100 then table.remove(recordedSeq, 1) end
    end
    if sniperMode then
        for _, v in pairs(RemoteLogScroll:GetChildren()) do
            if v:IsA("TextButton") then v:Destroy() end
        end
        remoteLogs = {}; logQueue = {}
        sniperMode = false
        btnSniper.Text = "Sniper"
    end
    if getgenv()._spamBlockEnabled then
        getgenv()._spamCount = getgenv()._spamCount or {}
        getgenv()._spamCount[remote] = (getgenv()._spamCount[remote] or 0) + 1
        if getgenv()._spamCount[remote] > 20 then
            blocklist[remote] = true
            addSysLog("Blocked spammy remote: "..remote.Name, "GUARD")
            return
        end
        task.delay(1, function() getgenv()._spamCount[remote] = 0 end)
    end

    while #logQueue >= MAX_LOGS do
        local oldest = table.remove(logQueue, 1)
        local e = remoteLogs[oldest]
        if e and e.button and e.button.Parent then e.button:Destroy() end
        remoteLogs[oldest] = nil
    end

    local argString = v2s(args)
    local groupKey = remote.Name.."|"..argString
    local generatedCode = string.format(
        "local args = %s\ngame:GetService(\"ReplicatedStorage\").%s:%s(unpack(args))",
        argString, remote.Name,
        (remote.ClassName == "RemoteEvent" and "FireServer" or "InvokeServer"))

    if remoteLogs[groupKey] then
        local e = remoteLogs[groupKey]
        e.count = e.count + 1
        if e.button and e.button.Parent then
            e.button.Text = " "..remote.Name.." (x"..e.count..")"
            e.button.LayoutOrder = layoutOrderNum
        end
        layoutOrderNum = layoutOrderNum - 1
        return
    end

    local b = create("TextButton", {
        Name = remote.Name, LayoutOrder = layoutOrderNum,
        Size = UDim2.new(1, -4, 0, 32),
        Text = " "..remote.Name..(isLoaded and " [LOADED]" or "")..
               (remote.Name:lower():match("ban") or remote.Name:lower():match("kick") and " [DANGER]" or ""),
        BackgroundColor3 = getNameColor(remote.Name),
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Gotham, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
    }, RemoteLogScroll)
    corner(b, 6)
    layoutOrderNum = layoutOrderNum - 1

    local origCol = b.BackgroundColor3
    remoteLogs[groupKey] = {button = b, count = 1, origCol = origCol, code = generatedCode, remote = remote, args = args}
    table.insert(logQueue, groupKey)

    b.MouseButton1Click:Connect(function()
        if multiMode then
            local idx
            for i, v in ipairs(multiList) do if v.key == groupKey then idx = i; break end end
            if idx then
                table.remove(multiList, idx); b.BackgroundColor3 = origCol
            else
                table.insert(multiList, {remote = remote, args = args, key = groupKey})
                b.BackgroundColor3 = currentTheme.Success
            end
            updateMultiCode()
        else
            selectedRemote = remote
            selectedArgs = args
            CodeView.Text = generatedCode
            if EdBox then EdBox.Text = yinetsuBeautify(args) end
            for _, v in pairs(RemoteLogScroll:GetChildren()) do
                if v:IsA("TextButton") and v ~= b then
                    TweenService:Create(v, TweenInfo.new(0.15), {BackgroundColor3 = remoteLogs[v.Name.."|"..v2s({})] and currentTheme.SurfaceAlt or currentTheme.SurfaceAlt}):Play()
                end
            end
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = currentTheme.Accent}):Play()
        end
    end)

    b.MouseEnter:Connect(function()
        if not multiMode then
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = currentTheme.Accent}):Play()
        end
    end)
    b.MouseLeave:Connect(function()
        if not multiMode then
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = origCol}):Play()
        end
    end)
end

