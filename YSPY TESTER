            Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end)
    button.MouseLeave:Connect(function()
        tw(button, 0.25, {BackgroundColor3 = baseColor})
        tw(button, 0.22, {Size = baseSize})
    end)
    button.MouseButton1Down:Connect(function()
        tw(button, 0.08, {Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset - shrink, baseSize.Y.Scale, baseSize.Y.Offset - shrink)})
    end)
    button.MouseButton1Up:Connect(function()
        tw(button, 0.15, {Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset + expand, baseSize.Y.Scale, baseSize.Y.Offset + expand)},
            Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end)
    return button
end

-- ============================================================
-- YINETSU BRAIN + SERIALIZER (unchanged)
-- ============================================================
local function yinetsuBeautify(v, indent, visited)
    indent = indent or 0; visited = visited or {}
    if visited[v] then return "recursive_table" end
    visited[v] = true
    local spacing = string.rep(" ", indent)
    local t = typeof(v)
    if t == "number" or t == "boolean" then return tostring(v)
    elseif t == "string" then return '"' .. v:gsub('"', '\\"') .. '"'
    elseif t == "Vector3" then return "Vector3.new("..tostring(v)..")"
    elseif t == "Vector2" then return "Vector2.new("..tostring(v)..")"
    elseif t == "CFrame" then return "CFrame.new("..tostring(v)..")"
    elseif t == "Color3" then return "Color3.new("..tostring(v)..")"
    elseif t == "UDim2" then return "UDim2.new("..tostring(v)..")"
    elseif t == "EnumItem" then return tostring(v)
    elseif t == "Instance" then return v:GetFullName()
    elseif t == "table" then
        local s = "{\n"; local count = 0
        for k, val in next, v do
            count = count + 1
            s = s .. spacing .. " [" .. yinetsuBeautify(k, indent+1, visited) .. "] = " .. yinetsuBeautify(val, indent+1, visited) .. ",\n"
        end
        return count == 0 and "{}" or s .. spacing .. "}"
    end
    return "nil"
end

local function v2s(v, visited)
    visited = visited or {}
    if visited[v] then return "recursive_table" end
    visited[v] = true
    local t = typeof(v)
    if t == "number" or t == "boolean" then return tostring(v)
    elseif t == "string" then return '"' .. v:gsub('"', '\\"') .. '"'
    elseif t == "Vector3" then return "Vector3.new("..tostring(v)..")"
    elseif t == "Vector2" then return "Vector2.new("..tostring(v)..")"
    elseif t == "CFrame" then return "CFrame.new("..tostring(v)..")"
    elseif t == "Color3" then return "Color3.new("..tostring(v)..")"
    elseif t == "EnumItem" then return tostring(v)
    elseif t == "Instance" then return v:GetFullName()
    elseif t == "table" then
        local s = "{"
        for k, val in next, v do
            s = s .. "[" .. v2s(k, visited) .. "] = " .. v2s(val, visited) .. ", "
        end
        return s:sub(1, #s-2) .. "}"
    end
    return "nil"
end

