local function addSysLog(msg, cat)
    cat = cat or "INFO"
    table.insert(logEntries, {Time=os.date("%H:%M:%S"), Category=cat, Message=tostring(msg)})
    if #logEntries > 250 then table.remove(logEntries, 1) end
    if LogView then
        local lines = {}
        for _, item in ipairs(logEntries) do
            table.insert(lines, string.format("[%s] [%s] %s", item.Time, item.Category, item.Message))
        end
        LogView.Text = table.concat(lines, "\n")
    end
end

